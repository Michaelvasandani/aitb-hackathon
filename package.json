{
  "name": "hack-ai-thon-in-a-box",
  "private": true,
  "type": "module",
  "description": "Static build of the Hack-AI-Thon-in-a-Box planner. No dependencies, no build step.",
  "scripts": {
    "rules": "python3 scripts/export_rules.py",
    "test": "python3 -m unittest discover -s tests -t . -q",
    "test:js": "node --test tests/js/",
    "test:all": "npm run test && npm run test:js",
    "dev": "python3 scripts/devserver.py",
    "db:init": "bash scripts/db-init.sh",
    "db:verify-guard": "node scripts/verify-guard.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@neondatabase/serverless": "^1.1.0"
  }
}
